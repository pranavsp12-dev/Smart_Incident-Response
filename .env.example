# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend CORS Origin (e.g. Next.js app)
CORS_ORIGIN=http://localhost:3000

# Authentication (use a securely generated random value of at least 32 characters)
JWT_SECRET=CHANGE_ME

# PostgreSQL Configuration (Relational data: Incidents, Users, Schedules)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=smart_incident
PG_USER=postgres
PG_PASSWORD=your_postgres_password

# MongoDB Configuration (Document data: Audit logs, Incident timelines, Raw alert payloads)
MONGO_URI=mongodb://localhost:27017/smart_incident_logs
